{\n  \"name\": \"donor-assistance-backend\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Backend API for Donor Assistance App\",\n  \"main\": \"src/server.js\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"nodemon src/server.js\",\n    \"start\": \"node src/server.js\",\n    \"build\": \"echo 'Backend uses ES modules, no build needed'\",\n    \"test\": \"jest --detectOpenHandles\",\n    \"test:coverage\": \"jest --coverage\",\n    \"lint\": \"eslint src/\",\n    \"lint:fix\": \"eslint src/ --fix\",\n    \"migrate\": \"node src/migrations/migrate.js\",\n    \"migrate:create\": \"node src/migrations/create.js\",\n    \"migrate:rollback\": \"node src/migrations/rollback.js\",\n    \"seed\": \"node src/seeds/seed.js\"\n  },\n  \"keywords\": [\"donation\", \"charity\", \"beneficiary\", \"assistance\"],\n  \"author\": \"Donor Assistance Team\",\n  \"license\": \"MIT\",\n  \"dependencies\": {\n    \"express\": \"^4.18.2\",\n    \"dotenv\": \"^16.3.1\",\n    \"cors\": \"^2.8.5\",\n    \"helmet\": \"^7.0.0\",\n    \"bcryptjs\": \"^2.4.3\",\n    \"jsonwebtoken\": \"^9.1.2\",\n    \"joi\": \"^17.11.0\",\n    \"pg\": \"^8.11.3\",\n    \"sequelize\": \"^6.35.2\",\n    \"axios\": \"^1.6.2\",\n    \"stripe\": \"^14.8.0\",\n    \"nodemailer\": \"^6.9.7\",\n    \"winston\": \"^3.11.0\",\n    \"express-rate-limit\": \"^7.1.5\",\n    \"uuid\": \"^9.0.1\"\n  },\n  \"devDependencies\": {\n    \"nodemon\": \"^3.0.2\",\n    \"jest\": \"^29.7.0\",\n    \"supertest\": \"^6.3.3\",\n    \"eslint\": \"^8.54.0\",\n    \"prettier\": \"^3.1.1\"\n  },\n  \"engines\": {\n    \"node\": \">=18.0.0\",\n    \"npm\": \">=9.0.0\"\n  }\n}\n